{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shockaudit-stage1-preview",
  "main": "../../src/worker/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "STAGE1_PREVIEW_ONLY": "true",
    "SHOCKAUDIT_STAGE1_PREVIEW_DEPLOYMENT": "true"
  },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/mcp/*", "/health", "/assets/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_RUNTIME",
        "class_name": "ShockAuditMcp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShockAuditMcp"]
    }
  ],
  "observability": {
    "enabled": true
  }
}

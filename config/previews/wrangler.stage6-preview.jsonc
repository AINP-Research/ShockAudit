{
  // Compatibility preview profile. Production uses the root wrangler.jsonc;
  // production build and deployment commands do not select this file.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shockaudit-stage6-candidate",
  "main": "../../src/worker/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/mcp/*", "/health", "/assets/*"]
  },
  "vars": {
    // Candidate-only feasibility measurement. Shadow results never replace
    // or alter the proven Screen 2 response, expose context leads, or enable a
    // fresh Screen 3 context lookup.
    "SCREEN02_SEARCH_EXPANSION_MODE": "shadow"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_RUNTIME",
        "class_name": "ShockAuditMcp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShockAuditMcp"]
    }
  ],
  "observability": {
    "enabled": true
  }
}

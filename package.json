{
  "name": "shockaudit",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "A ChatGPT-native workspace for designing and auditing natural experiments.",
  "scripts": {
    "dev": "npm run build:local-preview && wrangler dev",
    "build:local-preview": "vite build && node scripts/verify-local-preview-artifact.mjs && tsc --noEmit",
    "dev:browser": "npm run build && wrangler dev --config tests/browser/wrangler.jsonc",
    "dev:ui": "vite",
    "build": "vite build && node scripts/verify-build-artifact.mjs && tsc --noEmit",
    "audit:runtime": "node scripts/run-lockfile-audit.mjs runtime",
    "audit:full": "node scripts/run-lockfile-audit.mjs full",
    "test": "vitest run",
    "test:release": "node scripts/run-release-test-baseline.mjs",
    "test:browser": "playwright test",
    "test:browser:list": "playwright test --list",
    "check:benchmarks": "node scripts/check-generalization-benchmarks.mjs && vitest run tests/benchmarks/production-generalization.test.ts",
    "check:catalog-schema": "node scripts/verify-catalog-schema-budget.mjs",
    "update:public-event-index": "node scripts/validate-public-event-index.mjs --update",
    "check:public-event-index": "node scripts/validate-public-event-index.mjs && vitest run tests/core/screen02-discovery-first-index.test.ts",
    "check:static-prohibited": "node scripts/check-prohibited-production-paths.mjs",
    "check:production-matrix-contract": "node --check scripts/verify-production-matrix.mjs && node scripts/verify-production-matrix.mjs --list",
    "check:release-gates": "npm run check:benchmarks && npm run check:catalog-schema && npm run check:public-event-index && npm run check:static-prohibited && npm run check:production-matrix-contract",
    "check:local-persistence": "node scripts/verify-local-persistence-restart.mjs",
    "check": "node scripts/run-repository-check.mjs",
    "check:full": "npm run test:release && npm run build && npm run check:release-gates",
    "check:cloudflare": "npm run build && npm run check:release-gates",
    "check:live": "node scripts/verify-live-mcp.mjs",
    "check:production-matrix": "node scripts/verify-production-matrix.mjs --suite all",
    "check:product-qualification": "node scripts/check-product-qualification.mjs",
    "check:post-deployment-acceptance": "node scripts/verify-production-qualification.mjs",
    "check:stage6-evidence": "node scripts/verify-stage6-evidence.mjs",
    "deploy": "npm run check && npm run deploy:production",
    "deploy:production": "node scripts/verify-production-branch.mjs && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.1",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/workers-types": "5.20261018.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.0.5",
    "terser": "5.44.0",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "wrangler": "4.151.1",
    "yaml": "2.9.0"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.11",
    "qs": "6.17.0",
    "sharp": "0.35.5",
    "undici": "7.30.1"
  }
}

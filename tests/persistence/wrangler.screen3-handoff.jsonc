{
  // Local-only durable persistence fixture. This file is never a deployment
  // target and uses a guarded temporary --persist-to directory in the runner.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shockaudit-screen3-handoff-persistence-fixture",
  "main": "./screen3-handoff-fixture-worker.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/mcp",
      "/mcp/*",
      "/health",
      "/__persistence-fixture/screen3-handoff"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_RUNTIME",
        "class_name": "ShockAuditPersistenceMcp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShockAuditPersistenceMcp"]
    }
  ],
  "workers_dev": false,
  "observability": { "enabled": false }
}

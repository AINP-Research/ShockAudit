{
  // Browser-only, fail-closed connector harness. Never use this config for a
  // production deployment; wrangler.jsonc remains the production entrypoint.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shockaudit-browser-fixture",
  "main": "./fixture-worker.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/mcp",
      "/mcp/*",
      "/health",
      "/assets/*",
      "/__browser-fixture/official-transport-probe"
    ]
  },
  "workers_dev": false,
  "observability": {
    "enabled": false
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shockaudit.example/schemas/screen23-gold-corpus-v1.json",
  "title": "ShockAudit Screen 2–3 frozen gold-corpus definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "corpusId", "status", "sourcePacketPolicy", "cases"],
  "properties": {
    "$schema": { "const": "./SCREEN-23-GOLD-CORPUS.schema.json" },
    "schemaVersion": { "const": "shockaudit-screen23-gold-corpus-v1" },
    "corpusId": { "const": "screen23-eight-case-v1" },
    "status": { "const": "definition-only" },
    "sourcePacketPolicy": { "type": "string", "minLength": 20 },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "label", "jurisdiction", "eventFamily", "requiredModes", "requiredSourceFamilies", "requiredFeatures"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "label": { "type": "string", "minLength": 3 },
          "jurisdiction": { "type": "string", "minLength": 2 },
          "eventFamily": { "enum": ["regulation", "disaster"] },
          "requiredModes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["find", "audit"] } },
          "requiredSourceFamilies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
          "requiredFeatures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } }
        }
      }
    }
  }
}

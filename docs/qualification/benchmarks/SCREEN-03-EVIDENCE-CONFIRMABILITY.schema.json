{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shockaudit.ainp-research/schemas/screen-03-evidence-confirmability-benchmark-v1.json",
  "title": "ShockAudit Screen 3 evidence and confirmability benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkId", "frozen", "productionImportForbidden", "reviewedAt", "cases"],
  "properties": {
    "schemaVersion": { "const": "shockaudit-screen03-evidence-confirmability-benchmark-v1" },
    "benchmarkId": { "const": "screen03-cross-platform-v1" },
    "frozen": { "const": true },
    "productionImportForbidden": { "const": true },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "claimId", "claimType", "sourcePlatform", "sourceId", "authorityTier", "evidenceBasis", "expectedSupportClass", "expectedConfirmability", "expectedReason", "exactOfficialSupport", "input", "actions", "scenarioTags", "reviewedAt"],
        "properties": {
          "eventId": { "type": "string", "minLength": 2 },
          "claimId": { "type": "string", "minLength": 2 },
          "claimType": { "enum": ["identity", "substantive", "timeline", "coverage", "amendment"] },
          "sourcePlatform": { "type": "string", "minLength": 2 },
          "sourceId": { "type": "string", "minLength": 2 },
          "authorityTier": { "type": "integer", "minimum": 1, "maximum": 6 },
          "evidenceBasis": { "enum": ["official-structured-field", "official-passage", "contextual-lead", "unavailable", "malformed", "changed"] },
          "expectedSupportClass": { "enum": ["direct", "indirect", "conflicting", "unsupported"] },
          "expectedConfirmability": { "type": "boolean" },
          "expectedReason": { "type": "string", "minLength": 8 },
          "exactOfficialSupport": { "type": ["string", "null"] },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "label", "value", "proposalSupport", "sourceRole", "sourcePlatform", "documentType", "evidenceStatus", "passages", "conflict", "sourceChange"],
            "properties": {
              "group": { "enum": ["identity", "overview", "timeline", "component", "eligibility", "amendment", "required-variable"] },
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 },
              "proposalSupport": { "enum": ["direct", "indirect", "conflicting", "unsupported"] },
              "sourceRole": { "enum": ["controlling-legal-record", "precursor-official-record", "related-official-record", "official-publication-record", "administrative-declaration-record", "scientific-hazard-record", "institutional-hazard-record", "official-record", "related-secondary-record", "researcher-supplied-record"] },
              "sourcePlatform": { "enum": ["federal-register", "govinfo", "congress", "us-state-official", "eur-lex", "eu-publications", "uk-legislation", "national-legislation", "regulatory-agency", "official-disaster-repository", "secondary-publisher", "researcher-supplied", "other-official", "unknown"] },
              "documentType": { "enum": ["structured-metadata", "html", "xml", "json", "pdf", "plain-text", "official-guidance", "unknown"] },
              "evidenceStatus": { "enum": ["retrieved", "changed"] },
              "passages": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "basis", "officialField"],
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "basis": { "enum": ["source-excerpt", "official-record-field", "official-document-passage", "official-guidance-passage", "contextual-secondary", "source-metadata"] },
                    "officialField": { "enum": ["canonical-title", "common-name", "formal-identifier", "issuer", "issuing-jurisdiction", "status", "event-type", null] }
                  }
                }
              },
              "conflict": { "type": "boolean" },
              "sourceChange": {
                "type": "object",
                "additionalProperties": false,
                "required": ["targetRelation", "preChangeDecision"],
                "properties": {
                  "targetRelation": { "enum": ["claim-linked-source", "unlinked-control-source"] },
                  "preChangeDecision": { "enum": ["accept", "unresolved"] }
                }
              }
            }
          },
          "actions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["confirm", "correct", "unresolved", "reject", "restore", "sourceChange", "hostMapping"],
            "properties": {
              "confirm": { "enum": ["enabled-and-persists", "disabled"] },
              "correct": { "enum": ["available", "unavailable"] },
              "unresolved": { "const": "available-and-persists" },
              "reject": { "const": "available-and-persists" },
              "restore": { "const": "preserves-decision" },
              "sourceChange": { "enum": ["preserves-decision", "reopens-decision"] },
              "hostMapping": { "enum": ["not-required", "may-propose-noncanonical", "must-reject"] }
            }
          },
          "scenarioTags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
          "reviewedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}

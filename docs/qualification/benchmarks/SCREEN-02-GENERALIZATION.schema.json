{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shockaudit.ainp-research/schemas/screen-02-generalization-benchmark-v1.json",
  "title": "ShockAudit Screen 2 generalization benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkId", "frozen", "productionImportForbidden", "reviewedAt", "cases"],
  "properties": {
    "schemaVersion": { "const": "shockaudit-screen02-generalization-benchmark-v1" },
    "benchmarkId": { "const": "screen02-cross-domain-v1" },
    "frozen": { "const": true },
    "productionImportForbidden": { "const": true },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeId", "population", "industry", "geography", "studyPeriod", "eventFamily", "outcomeFamily", "candidateId", "expectedMaximumClass", "expectedExclusion", "rationale", "sourceIds", "candidateInput", "reviewedAt"],
        "properties": {
          "scopeId": { "type": "string", "minLength": 3 },
          "population": { "type": "string", "minLength": 2 },
          "industry": { "type": "string", "minLength": 2 },
          "geography": { "type": "string", "minLength": 2 },
          "studyPeriod": { "type": "string", "pattern": "^[0-9]{4}[–-][0-9]{4}$" },
          "eventFamily": { "type": "string", "minLength": 2 },
          "outcomeFamily": { "type": "string", "minLength": 2 },
          "candidateId": { "type": "string", "minLength": 2 },
          "expectedMaximumClass": { "enum": ["direct", "adjacent", "broad", "mismatch"] },
          "expectedExclusion": { "type": ["string", "null"] },
          "rationale": { "type": "string", "minLength": 20 },
          "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
          "candidateInput": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "industryEvidence", "affectedPopulation"],
            "properties": {
              "title": { "type": "string", "minLength": 2 },
              "industryEvidence": { "type": "string", "minLength": 2 },
              "affectedPopulation": { "type": "string", "minLength": 2 }
            }
          },
          "reviewedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
